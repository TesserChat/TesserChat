<Project>

  <!--
    Solution-wide build settings. The whole solution tracks a single .NET LTS — bump
    TargetFramework here (and in .github/workflows/ci.yml) rather than per-project.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>TesserChat contributors</Authors>
    <Product>TesserChat</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/sebastianpiresmolin/TesserChat</RepositoryUrl>
  </PropertyGroup>

</Project>
