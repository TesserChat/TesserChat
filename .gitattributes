# Normalize to LF in the repository; Git checks out native line endings per platform.
# CI builds on ubuntu/windows/macos, so this keeps diffs from churning between contributors.
* text=auto eol=lf

# Windows-only tooling that expects CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Treat known binaries as binary so Git never rewrites them.
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.dll binary
*.so binary
*.dylib binary
*.snk binary
