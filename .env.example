# TesserChat compose configuration.
#
#   cp .env.example .env
#
# .env is gitignored. Everything here has a working default except POSTGRES_PASSWORD, which
# compose refuses to start without.

# --- Database ---------------------------------------------------------------------------------

# Required. Any long random string; nothing but the server reads it.
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# Defaults are fine unless you have a reason.
#POSTGRES_DB=tesserchat
#POSTGRES_USER=tesserchat

# --- Server -----------------------------------------------------------------------------------

# Host port. Bound to 127.0.0.1 by the compose file, so this is reachable from the machine running
# it and nowhere else until you put a reverse proxy in front.
#TESSERCHAT_PORT=8080

# The name members see. Can also be chosen by the client that completes setup.
#TESSERCHAT_SETUP__SERVERNAME=My Community

# --- Who becomes Owner (read this before exposing the server) -----------------------------------
#
# First-run setup is unauthenticated — there is no Owner yet to authorize it (ARCHITECTURE.md
# 5.6). Two ways that resolves:
#
#   Unset (default)  The first client to complete setup becomes the Owner. Fine while the server
#                    is only reachable from your own machine. On a public address it is a race you
#                    can lose in seconds, and the server warns on every boot while this applies.
#
#   Set              Only this key can complete setup. Setup stops being a race and becomes a
#                    claim exactly one key can make, so publishing a fresh server is safe.
#
# Set it to your own public key — the client shows this, and it takes either the bare signing key
# or the full shareable identity token.
#TESSERCHAT_SETUP__OWNERPUBLICKEY=

# --- Who may join (ARCHITECTURE.md 5.2) ---------------------------------------------------------
#
#   Open           Anyone may register. The default.
#   PasswordGated  A shared password is required to join. Existing members are unaffected by
#                  changing it later — the password gates registration, never login.
#   AllowlistOnly  Only pre-approved public keys may register. Set the list in appsettings.json;
#                  it is a list, so an environment variable is awkward.
#
#TESSERCHAT_CONNECTION__MODE=Open

# For PasswordGated. This is a HASH, never the password itself — produce it with:
#
#   docker compose run --rm tesserchat hash-join-secret "your joining password"
#
#TESSERCHAT_CONNECTION__JOINSECRETHASH=
